<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Creative Mindz | AI Creative Content & Visual Storytelling</title>

  <meta
    name="description"
    content="Creative Mindz by David — AI creative content, visual storytelling, video advertisements, product visuals, animation, voiceovers and creative brand storytelling."
  />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #07090d;
      --bg-soft: #0c1017;
      --card: #111720;
      --card-hover: #151d28;
      --blue: #2488ff;
      --blue-light: #65b0ff;
      --gold: #f2c14e;
      --white: #ffffff;
      --text: #edf2f7;
      --muted: #9ca9b8;
      --border: rgba(255, 255, 255, 0.09);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    button {
      font-family: inherit;
    }

    /* =========================
       NAVIGATION
    ========================= */

    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(7, 9, 13, 0.88);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid var(--border);
    }

    .nav-container {
      max-width: 1180px;
      margin: auto;
      padding: 13px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-logo {
      width: 45px;
      height: 45px;
      object-fit: contain;
      border-radius: 8px;
    }

    .brand-name {
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: 0.4px;
    }

    .brand-name span {
      color: var(--gold);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 27px;
      list-style: none;
    }

    .nav-links a {
      color: var(--muted);
      font-size: 0.92rem;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: var(--white);
    }

    .nav-cta {
      background: var(--gold);
      color: #080a0e !important;
      padding: 10px 17px;
      border-radius: 7px;
      font-weight: 700;
    }

    .nav-cta:hover {
      opacity: 0.9;
    }

    .menu-btn {
      display: none;
      background: none;
      border: none;
      color: white;
      font-size: 1.6rem;
      cursor: pointer;
    }

    /* =========================
       GENERAL
    ========================= */

    .container {
      width: min(1180px, calc(100% - 40px));
      margin: auto;
    }

    section {
      padding: 100px 0;
    }

    .section-label {
      color: var(--blue-light);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .section-title {
      font-size: clamp(2rem, 5vw, 3.3rem);
      line-height: 1.1;
      margin-bottom: 18px;
    }

    .section-description {
      max-width: 720px;
      color: var(--muted);
      font-size: 1.02rem;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 135px;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 650px;
      height: 650px;
      background: rgba(36, 136, 255, 0.12);
      filter: blur(140px);
      border-radius: 50%;
      top: -200px;
      right: -200px;
      pointer-events: none;
    }

    .hero-content {
      max-width: 920px;
      position: relative;
      z-index: 2;
    }

    .hero-logo {
      width: 105px;
      height: 105px;
      object-fit: contain;
      margin-bottom: 25px;
      border-radius: 16px;
    }

    .hero-tag {
      display: inline-block;
      color: var(--gold);
      border: 1px solid rgba(242, 193, 78, 0.35);
      background: rgba(242, 193, 78, 0.06);
      padding: 7px 13px;
      border-radius: 50px;
      font-size: 0.78rem;
      font-weight: 700;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-size: clamp(3rem, 8vw, 6.2rem);
      line-height: 0.98;
      letter-spacing: -3px;
      margin-bottom: 25px;
    }

    .hero h1 .blue {
      color: var(--blue);
    }

    .hero h1 .gold {
      color: var(--gold);
    }

    .hero-subtitle {
      font-size: clamp(1.15rem, 2.5vw, 1.55rem);
      color: #d6dee9;
      max-width: 800px;
      margin-bottom: 16px;
      font-weight: 600;
    }

    .hero-description {
      color: var(--muted);
      max-width: 780px;
      font-size: 1rem;
      margin-bottom: 32px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 13px 21px;
      border-radius: 7px;
      font-weight: 800;
      font-size: 0.92rem;
      transition: 0.3s;
      cursor: pointer;
      border: none;
    }

    .btn-primary {
      background: var(--gold);
      color: #080a0e;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      opacity: 0.92;
    }

    .btn-secondary {
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--white);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    /* =========================
       SERVICES
    ========================= */

    .services {
      background: var(--bg-soft);
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 48px;
    }

    .service-card {
      background: var(--card);
      border: 1px solid var(--border);
      padding: 28px;
      border-radius: 14px;
      transition: 0.3s;
    }

    .service-card:hover {
      transform: translateY(-5px);
      background: var(--card-hover);
      border-color: rgba(36, 136, 255, 0.3);
    }

    .service-number {
      color: var(--gold);
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 20px;
    }

    .service-card h3 {
      margin-bottom: 10px;
      font-size: 1.18rem;
    }

    .service-card p {
      color: var(--muted);
      font-size: 0.92rem;
    }

    /* =========================
       PROJECTS
    ========================= */

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
      margin-top: 50px;
    }

    .project-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 15px;
      overflow: hidden;
    }

    .project-media {
      background: #05070a;
      aspect-ratio: 16 / 10;
      overflow: hidden;
    }

    .project-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: 0.5s;
    }

    .project-card:hover .project-media img {
      transform: scale(1.03);
    }

    .project-video {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      background: #05070a;
    }

    .project-info {
      padding: 24px;
    }

    .project-type {
      color: var(--blue-light);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.7rem;
      font-weight: 800;
      margin-bottom: 9px;
    }

    .project-info h3 {
      font-size: 1.35rem;
      margin-bottom: 9px;
    }

    .project-info p {
      color: var(--muted);
      font-size: 0.91rem;
    }

    .project-full {
      grid-column: 1 / -1;
    }

    .project-full .project-media {
      aspect-ratio: 16 / 8;
    }

    /* =========================
       EBOOK
    ========================= */

    .ebook-section {
      background: var(--bg-soft);
    }

    .ebook-wrapper {
      margin-top: 45px;
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 45px;
      align-items: center;
      background: var(--card);
      border: 1px solid var(--border);
      padding: 35px;
      border-radius: 16px;
    }

    .ebook-cover {
      width: 100%;
      max-width: 300px;
      margin: auto;
      border-radius: 10px;
      box-shadow: 0 15px 45px rgba(0, 0, 0, 0.35);
    }

    .ebook-content h3 {
      font-size: 1.8rem;
      margin-bottom: 14px;
    }

    .ebook-content p {
      color: var(--muted);
      margin-bottom: 22px;
      max-width: 650px;
    }

    /* =========================
       ABOUT
    ========================= */

    .about-grid {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 60px;
      align-items: center;
      margin-top: 50px;
    }

    .about-logo {
      width: 220px;
      height: 220px;
      object-fit: contain;
      margin: auto;
      border-radius: 20px;
    }

    .about-content h3 {
      font-size: 1.8rem;
      margin-bottom: 15px;
    }

    .about-content p {
      color: var(--muted);
      margin-bottom: 16px;
    }

    .creator-label {
      display: inline-block;
      color: var(--gold);
      font-weight: 800;
      margin-bottom: 15px;
    }

    /* =========================
       PROCESS
    ========================= */

    .process {
      background: var(--bg-soft);
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 48px;
    }

    .process-card {
      padding: 25px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
    }

    .process-card span {
      display: block;
      color: var(--gold);
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 15px;
    }

    .process-card h3 {
      margin-bottom: 9px;
    }

    .process-card p {
      color: var(--muted);
      font-size: 0.9rem;
    }

    /* =========================
       TOOLS
    ========================= */

    .tools {
      text-align: center;
    }

    .tools-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 35px;
    }

    .tool {
      padding: 10px 17px;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 50px;
      color: #dce5ef;
      font-size: 0.88rem;
    }

    /* =========================
       FEEDBACK
    ========================= */

    .feedback-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 45px;
    }

    .feedback-card {
      padding: 25px;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 14px;
    }

    .stars {
      color: var(--gold);
      letter-spacing: 2px;
      margin-bottom: 15px;
    }

    .feedback-card p {
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 18px;
    }

    .feedback-name {
      font-size: 0.82rem;
      font-weight: 800;
    }

    .feedback-note {
      color: var(--blue-light);
      font-size: 0.72rem;
      margin-top: 3px;
    }

    .feedback-action {
      margin-top: 35px;
      text-align: center;
    }

    /* =========================
       FAQ
    ========================= */

    .faq {
      background: var(--bg-soft);
    }

    .faq-list {
      max-width: 850px;
      margin: 45px auto 0;
    }

    .faq-item {
      border-bottom: 1px solid var(--border);
    }

    .faq-question {
      width: 100%;
      background: none;
      border: none;
      color: var(--white);
      padding: 22px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      text-align: left;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
    }

    .faq-icon {
      color: var(--gold);
      font-size: 1.4rem;
      transition: 0.3s;
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .faq-answer p {
      color: var(--muted);
      padding: 0 0 20px;
      font-size: 0.92rem;
    }

    .faq-item.active .faq-answer {
      max-height: 200px;
    }

    .faq-item.active .faq-icon {
      transform: rotate(45deg);
    }

    /* =========================
       FINAL CTA
    ========================= */

    .final-cta {
      text-align: center;
      padding: 110px 20px;
      position: relative;
      overflow: hidden;
    }

    .final-cta::before {
      content: "";
      position: absolute;
      width: 500px;
      height: 500px;
      background: rgba(242, 193, 78, 0.08);
      filter: blur(130px);
      border-radius: 50%;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .final-cta-content {
      position: relative;
      z-index: 2;
    }

    .final-cta h2 {
      font-size: clamp(2.2rem, 5vw, 4.5rem);
      line-height: 1;
      margin-bottom: 20px;
    }

    .final-cta p {
      color: var(--muted);
      max-width: 650px;
      margin: 0 auto 28px;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      border-top: 1px solid var(--border);
      padding: 28px 0;
      background: #05070a;
    }

    .footer-container {
      max-width: 1180px;
      width: calc(100% - 40px);
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .footer-brand {
      font-weight: 800;
    }

    .footer-brand span {
      color: var(--blue);
    }

    .footer-text {
      color: var(--muted);
      font-size: 0.78rem;
      text-align: right;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 900px) {
      .services-grid,
      .process-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .feedback-grid {
        grid-template-columns: 1fr;
      }

      .about-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .ebook-wrapper {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .ebook-cover {
        margin: auto;
      }
    }

    @media (max-width: 720px) {
      section {
        padding: 75px 0;
      }

      .container {
        width: min(100% - 30px, 1180px);
      }

      .nav-container {
        padding: 12px 15px;
      }

      .menu-btn {
        display: block;
      }

      .nav-links {
        position: absolute;
        top: 72px;
        left: 0;
        width: 100%;
        background: rgba(7, 9, 13, 0.98);
        border-bottom: 1px solid var(--border);
        display: none;
        flex-direction: column;
        padding: 25px;
        gap: 22px;
      }

      .nav-links.active {
        display: flex;
      }

      .hero {
        padding-top: 120px;
        min-height: auto;
        padding-bottom: 80px;
      }

      .hero h1 {
        letter-spacing: -1.5px;
      }

      .hero-logo {
        width: 85px;
        height: 85px;
      }

      .hero-buttons {
        flex-direction: column;
        align-items: stretch;
      }

      .btn {
        width: 100%;
      }

      .services-grid,
      .process-grid,
      .projects-grid {
        grid-template-columns: 1fr;
      }

      .project-full {
        grid-column: auto;
      }

      .project-full .project-media {
        aspect-ratio: 16 / 10;
      }

      .ebook-wrapper {
        padding: 25px 20px;
      }

      .ebook-content h3 {
        font-size: 1.5rem;
      }

      .footer-container {
        flex-direction: column;
        text-align: center;
      }

      .footer-text {
        text-align: center;
      }
    }
  </style>
</head>

